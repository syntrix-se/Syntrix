<?xml version="1.0" encoding="utf-8"?>
<!-- Syntrix example: the block takes the use object SyntrixUse that Syntrix ships (API 4): F runs the action a mod
     registered with UseRegister (without one F opens the terminal), K opens the terminal. The power check keeps the
     Vanilla behaviour without power. -->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityContainers>
    <Container>
      <Id>
        <TypeId>FunctionalBlock</TypeId>
        <SubtypeId>SyntrixExample_Terminal</SubtypeId>
      </Id>
      <DefaultComponents>
        <Component BuilderType="MyObjectBuilder_BlockPowerCheckComponent" SubtypeId="ElectricityPoweredBlock" ForceCreate="true" />
        <Component BuilderType="MyObjectBuilder_UseObjectsComponent" SubtypeId="SyntrixUse" ForceCreate="true" />
      </DefaultComponents>
    </Container>
  </EntityContainers>
</Definitions>
